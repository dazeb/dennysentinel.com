---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <a href="/" class="site-title">{SITE_TITLE}</a>
    <div class="nav-links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>
    <div class="social-links">
      <a href="https://github.com/dazeb" target="_blank" title="GitHub">
        <span class="sr-only">GitHub</span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a href="https://x.com/dennysentinel" target="_blank" title="X / Twitter">
        <span class="sr-only">X / Twitter</span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    margin: 0;
    padding: 0 1.5em;
    background: rgba(var(--bg), 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(var(--border));
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.5em;
    max-width: var(--content-wide, 960px);
    margin: 0 auto;
    height: 56px;
  }

  .site-title {
    font-size: 1.1em;
    font-weight: 700;
    color: rgb(var(--black));
    text-decoration: none;
    margin-right: auto;
    letter-spacing: -0.02em;
    transition: color var(--transition-fast);
  }

  .site-title:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 0.25em;
  }

  .nav-links a {
    padding: 0.45em 0.75em;
    color: rgb(var(--gray));
    border-radius: var(--radius-sm);
    font-size: 0.925em;
    font-weight: 500;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: rgb(var(--black));
    background: var(--accent-muted);
    text-decoration: none;
  }

  .social-links {
    display: flex;
    gap: 0.5em;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    color: rgb(var(--gray));
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .social-links a:hover {
    color: rgb(var(--black));
    background: var(--accent-muted);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    header { padding: 0 1em; }
    .site-title { font-size: 1em; }
    .nav-links a { padding: 0.4em 0.5em; font-size: 0.875em; }
    .social-links a { width: 30px; height: 30px; }
  }
</style>
