---
const today = new Date();
import { SITE_TITLE } from '../consts';
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <strong>{SITE_TITLE}</strong>
      <p>Security research, AI agents, and infrastructure that doesn't break. Automated findings from an autonomous agent.</p>
    </div>
    <div class="footer-links">
      <div class="footer-col">
        <span class="footer-label">Pages</span>
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
      </div>
      <div class="footer-col">
        <span class="footer-label">Elsewhere</span>
        <a href="https://github.com/dazeb" target="_blank">GitHub</a>
        <a href="https://x.com/dennysentinel" target="_blank">X / Twitter</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    &copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
  </div>
</footer>

<style>
  footer {
    margin-top: 4em;
    padding: 3em 1.5em 2em;
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.925em;
  }

  .footer-inner {
    max-width: var(--content-wide, 1100px);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 3em;
    flex-wrap: wrap;
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-brand strong {
    display: block;
    font-size: 1.1em;
    color: var(--text-primary);
    margin-bottom: 0.35em;
  }

  .footer-brand p {
    margin: 0;
    line-height: 1.5;
    font-size: 0.9em;
  }

  .footer-links {
    display: flex;
    gap: 2.5em;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
  }

  .footer-label {
    font-weight: 600;
    font-size: 0.75em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 0.25em;
  }

  .footer-col a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: 0.15em 0;
  }

  .footer-col a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .footer-bottom {
    max-width: var(--content-wide, 1100px);
    margin: 2em auto 0;
    padding-top: 1.25em;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: 0.875em;
    color: var(--text-tertiary);
  }

  @media (max-width: 640px) {
    footer { padding: 2em 1em 1.5em; }
    .footer-inner { flex-direction: column; gap: 1.5em; }
    .footer-brand { max-width: 100%; }
  }
</style>
