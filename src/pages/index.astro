---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero -->
      <section class="hero">
        <h1 class="hero-title">{SITE_TITLE}</h1>
        <p class="hero-desc">{SITE_DESCRIPTION}</p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">Read the Blog</a>
          <a href="/about" class="btn btn-secondary">About Me</a>
        </div>
      </section>

      <!-- Recent Posts -->
      <section class="recent-posts">
        <h2 class="section-title">Recent Posts</h2>
        <div class="post-list">
          {
            posts.map((post) => (
              <a href={`/blog/${post.id}/`} class="post-card">
                <article>
                  {post.data.heroImage && (
                    <div class="post-card-img">
                      <img width={720} height={360} src={post.data.heroImage} alt={post.data.title} loading="lazy" />
                    </div>
                  )}
                  <div class="post-card-body">
                    <h3 class="post-card-title">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="post-card-desc">{post.data.description}</p>
                    )}
                    <span class="post-card-date">
                      <FormattedDate date={post.data.pubDate} />
                    </span>
                  </div>
                </article>
              </a>
            ))
          }
        </div>
        <div class="all-posts-link">
          <a href="/blog">View all posts &rarr;</a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Hero */
  .hero {
    text-align: center;
    padding: 4.5rem 1.25rem 2.75rem;
  }

  .hero-title {
    font-size: 3em;
    margin-bottom: 0.4em;
    background: linear-gradient(135deg, var(--accent), var(--accent-hover));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @supports not (-webkit-background-clip: text) {
    .hero-title {
      background: none;
      -webkit-text-fill-color: unset;
      color: var(--text-primary);
    }
  }

  .hero-desc {
    font-size: 1.15em;
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto 1.5em;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 0.75em;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.65em 1.5em;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.95em;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--accent);
    color: #0a0a0c;
  }
  .btn-primary:hover {
    background: var(--accent-hover);
    color: #0a0a0c;
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-primary);
  }
  .btn-secondary:hover {
    background: var(--bg-elevated);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  /* Section titles */
  .section-title {
    font-size: 1.35em;
    margin-bottom: 1.25em;
    padding-bottom: 0.5em;
    border-bottom: 1px solid var(--border);
  }

  /* Post list */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.25em;
  }

  .post-card {
    display: block;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .post-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .post-card article {
    display: flex;
    gap: 1.25em;
  }

  .post-card-img {
    flex-shrink: 0;
    width: 220px;
    overflow: hidden;
  }

  .post-card-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .post-card-body {
    padding: 1.5rem 1.5rem 1.5rem 0;
    flex: 1;
    min-width: 0;
  }

  .post-card-title {
    font-size: 1.15em;
    margin: 0 0 0.35em;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .post-card-desc {
    font-size: 0.9em;
    color: var(--text-secondary);
    margin: 0 0 0.5em;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-date {
    font-size: 0.8em;
    color: var(--text-secondary);
    opacity: 0.75;
  }

  .all-posts-link {
    text-align: center;
    margin-top: 1.5em;
  }

  .all-posts-link a {
    font-weight: 600;
    font-size: 0.95em;
  }

  @media (max-width: 720px) {
    .hero { padding: 3em 0 2em; }
    .hero-title { font-size: 2em; }

    .post-card article {
      flex-direction: column;
    }

    .post-card-img {
      width: 100%;
      height: 180px;
    }

    .post-card-body {
      padding: 0 1.15rem 1.15rem;
    }
  }
</style>
