---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: var(--content-wide, 1100px);
      }

      .blog-header {
        padding: 2em 0 1.5em;
      }

      .blog-header h1 {
        margin: 0 0 0.35em;
        font-size: 2em;
      }

      .blog-header p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 1em;
      }

      .post-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5em;
        margin-top: 1em;
      }

      .post-card {
        display: block;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        overflow: hidden;
        text-decoration: none;
        transition: all var(--transition-base);
      }

      .post-card:hover {
        border-color: var(--accent);
        box-shadow: var(--shadow-md);
        transform: translateY(-3px);
        text-decoration: none;
      }

      .post-card:first-child {
        grid-column: 1 / -1;
      }

      .post-card:first-child .card-img {
        height: 280px;
      }

      .card-img {
        width: 100%;
        height: 180px;
        overflow: hidden;
        background: var(--bg-elevated);
      }

      .card-img img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0;
        transition: transform 0.4s ease;
      }

      .post-card:hover .card-img img {
        transform: scale(1.04);
      }

      .card-body {
        padding: 1.25em;
      }

      .card-title {
        font-size: 1.1em;
        margin: 0 0 0.35em;
        color: var(--text-primary);
        line-height: 1.35;
      }

      .post-card:first-child .card-title {
        font-size: 1.35em;
      }

      .card-desc {
        font-size: 0.875em;
        color: var(--text-secondary);
        margin: 0 0 0.5em;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .card-date {
        font-size: 0.8em;
        color: var(--text-secondary);
        opacity: 0.75;
      }

      @media (max-width: 720px) {
        .post-grid {
          grid-template-columns: 1fr;
          gap: 1em;
        }

        .post-card:first-child .card-img {
          height: 200px;
        }

        .post-card:first-child .card-title {
          font-size: 1.1em;
        }

        .card-img {
          height: 160px;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="blog-header">
        <h1>Blog</h1>
        <p>Security research, AI agents, and infrastructure findings.</p>
      </div>

      <section class="post-grid">
        {
          posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="post-card">
              <article>
                {post.data.heroImage && (
                  <div class="card-img">
                    <img width={720} height={360} src={post.data.heroImage} alt={post.data.title} loading="lazy" />
                  </div>
                )}
                <div class="card-body">
                  <h3 class="card-title">{post.data.title}</h3>
                  {post.data.description && (
                    <p class="card-desc">{post.data.description}</p>
                  )}
                  <span class="card-date">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                </div>
              </article>
            </a>
          ))
        }
      </section>
    </main>
    <Footer />
  </body>
</html>
